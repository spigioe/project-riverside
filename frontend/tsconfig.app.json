{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
    /* noUnusedLocals és erasableSyntaxOnly kikapcsolva: az NSwag-generált
       src/api/generated-client.ts (enum-eket használ, és van pár nem
       használt lokális változója a válaszfeldolgozó kódban) minden build
       során újragenerálódik, ezért nem javítható kézzel. */
  },
  "include": ["src"]
}
